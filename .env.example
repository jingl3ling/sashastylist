# Copy to .env for local runs, and set the same names as variables on Railway. Never commit .env.
# ZooWork (the stylist agent). Create a key at https://platform.zoowork.ai
ZOOWORK_API_KEY=
# Written to agent/agent.json by `npm run create-agent`; set this instead on Railway.
ZOOWORK_AGENT_ID=

# stub = fake looks, no ZooWork calls. live = the real agent.
STYLIST_MODE=stub
PORT=8787

# Tavus (the video avatar). Create the PAL with `node pal/create-pal.mjs`, then put its id here.
TAVUS_API_KEY=
TAVUS_PAL_ID=
# Optional: only if the PAL has no default face.
TAVUS_FACE_ID=

# Serve the store from this same server (one Railway service). 1 = on.
SERVE_SITE=1
# Only if the store is hosted elsewhere (e.g. GitHub Pages): comma-separated origins allowed to call the API.
ALLOWED_ORIGINS=
